# Copy to .env and adjust. All keys use AGENTGRID_ prefix (see backend/agentgrid/config.py).

# Persistence — SQLite default; Postgres via compose --profile postgres
AGENTGRID_DATABASE_URL=sqlite:///./data/agentgrid.db
# AGENTGRID_DATABASE_URL=postgresql+psycopg://agentgrid:agentgrid@localhost:5432/agentgrid

# Queue — set USE_REDIS=1 when Redis is up (docker compose / multi-worker)
AGENTGRID_REDIS_URL=redis://localhost:6379/0
AGENTGRID_USE_REDIS=0

AGENTGRID_ARTIFACT_DIR=./.artifacts
AGENTGRID_SANDBOX_ROOT=./sandbox

# API auth — send as: Authorization: Bearer <token>  (SSE: ?token=)
AGENTGRID_API_TOKEN=dev-token

# Worker / reliability
AGENTGRID_WORKER_POLL_MS=500
AGENTGRID_JOB_TIMEOUT_S=120
AGENTGRID_VERIFY_TIMEOUT_S=30

# Backpressure + rate limit
AGENTGRID_MAX_QUEUE_DEPTH=32
AGENTGRID_RATE_LIMIT_PER_MINUTE=120

# Comma-separated CORS origins for the dashboard / local tools
AGENTGRID_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
